<!-- $Id$ -->
<testcase>
  <info>
    <p>
      Test page number format in Japanese for https://github.com/metanorma/xmlgraphics-fop/issues/7.
    </p>
  </info>
  <fo>
    <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
      <fo:layout-master-set>
        <fo:simple-page-master master-name="simple" page-height="3in" page-width="5in">
          <fo:region-body extent="0.5in"/>
          <fo:region-before extent="2in"/>
          <fo:region-after extent="0.5in"/>
        </fo:simple-page-master>
      </fo:layout-master-set>
      <fo:page-sequence master-reference="simple" format="&#x4E00;" force-page-count="no-force">
        <fo:static-content flow-name="xsl-region-after">
          <fo:block text-align="center"><fo:page-number/></fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
          <fo:block/>
          <fo:block break-after="page"/>
          <fo:block/>
        </fo:flow>
      </fo:page-sequence>
      <fo:page-sequence master-reference="simple" format="&#x4E00;" initial-page-number="20">
        <fo:static-content flow-name="xsl-region-after">
          <fo:block text-align="center"><fo:page-number/></fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
          <fo:block/>
          <fo:block break-after="page"/>
          <fo:block/>
        </fo:flow>
      </fo:page-sequence>
    </fo:root>
  </fo>
  <checks>
    <eval expected="一" xpath="(//word)[1]"/>
    <eval expected="二" xpath="(//word)[2]"/>
    <eval expected="二十" xpath="(//word)[3]"/>
    <eval expected="二十一" xpath="(//word)[4]"/>
  </checks>
</testcase>
