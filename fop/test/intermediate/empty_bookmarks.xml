<testcase>
  <info>
    <p>
      This test checks empty bookmarks in the IF output.
    </p>
  </info>
  <fo>
    <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:fox="http://xmlgraphics.apache.org/fop/extensions" xmlns:nav="http://xmlgraphics.apache.org/fop/intermediate/document-navigation">
      <fo:layout-master-set>
        <fo:simple-page-master master-name="page"
          page-height="320pt" page-width="420pt" margin="10pt">
          <fo:region-body/>
        </fo:simple-page-master>
      </fo:layout-master-set>
			<fo:bookmark-tree>
				<fo:bookmark starting-state="hide" internal-destination="foreword">
					<fo:bookmark-title>Foreword</fo:bookmark-title>
				</fo:bookmark>
				<fo:bookmark internal-destination="empty_bookmark">
					<fo:bookmark-title>—————</fo:bookmark-title>
				</fo:bookmark>
				<fo:bookmark starting-state="hide" internal-destination="empty_bookmark">
					<fo:bookmark-title>List of Tables</fo:bookmark-title>
					<fo:bookmark internal-destination="table1">
						<fo:bookmark-title>Table 1</fo:bookmark-title>
					</fo:bookmark>
				</fo:bookmark>
			</fo:bookmark-tree>

      <fo:page-sequence master-reference="page">
        <fo:flow flow-name="xsl-region-body" text-align="justify">
          
          <fo:block id="foreword" font-size="16pt" space-after="18pt" keep-with-next="always" margin-top="0pt" role="H1">Foreword</fo:block>
          
					<fo:block id="table1">Table 1.</fo:block>
					
        </fo:flow>
      </fo:page-sequence>
    </fo:root>
  </fo>
  <if-checks xmlns:if="http://xmlgraphics.apache.org/fop/intermediate" xmlns:nav="http://xmlgraphics.apache.org/fop/intermediate/document-navigation">

    <eval expected="4" xpath="count(//nav:bookmark)"/>
    <eval expected="1" xpath="count(//nav:bookmark[@title = '—————'])"/>
    <eval expected="1" xpath="count(//nav:bookmark[@title = 'List of Tables'])"/>
    <eval expected="1" xpath="count(//nav:bookmark[@title = 'Table 1'])"/>

  </if-checks>
</testcase>
